{
  "name": "中国古典诗词 · Next.js",
  "image": "mcr.microsoft.com/devcontainers/javascript-node:1-22-bookworm",
  "customizations": {
    "codespaces": {
      "openFiles": [
        "README.md",
        "app/page.tsx"
      ]
    },
    "vscode": {
      "extensions": [
        "dbaeumer.vscode-eslint"
      ]
    }
  },
  "updateContentCommand": "pnpm install && pnpm run build:data",
  "postAttachCommand": {
    "server": "pnpm run dev"
  },
  "portsAttributes": {
    "3000": {
      "label": "中国古典诗词",
      "onAutoForward": "openPreview"
    }
  },
  "forwardPorts": [
    3000
  ]
}
